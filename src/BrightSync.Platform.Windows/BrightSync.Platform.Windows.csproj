<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>BrightSync</RootNamespace>
    <AssemblyName>BrightSync.Platform.Windows</AssemblyName>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- MicroCom/WmiLight emit AOT analysis noise that does not apply to the Windows paths exercised here. -->
    <NoWarn>$(NoWarn);IL3053</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="10.0.12" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="WmiLight" Version="7.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BrightSync.Platform.Abstractions\BrightSync.Platform.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BrightSync" />
    <InternalsVisibleTo Include="BrightSync.Tests" />
  </ItemGroup>

</Project>
