---
import { RELEASES_URL } from '../data/site';
import Icon from './Icon.astro';
---

<section id="download">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Download</p>
      <h2>Get BrightSync.</h2>
      <p class="lead">Free, no account, no telemetry. Pick the build for your system.</p>
    </div>

    <div class="download-box">
      <a class="btn btn-primary" href={RELEASES_URL} rel="noopener" data-download-primary>
        <Icon name="download" size={20} /> <span data-download-label>Download the latest release</span>
      </a>
      <p class="muted" data-download-status>
        Looking for your build. If this stays empty, open the <a href={RELEASES_URL} rel="noopener">releases page</a>.
      </p>
    </div>

    <div class="dl-list" data-download-list hidden></div>

    <p class="muted" style="margin-top:1.5rem">
      Every release ships a <code>BrightSync-SHA256SUMS.txt</code> so you can verify downloads. Linux install
      commands are in the <a href="https://github.com/bberka/BrightSync#linux" rel="noopener">README</a> and the{' '}
      <a href="https://github.com/bberka/BrightSync/blob/master/docs/LINUX.md" rel="noopener">Linux guide</a>.
    </p>
  </div>
</section>

<script>
  // Progressive enhancement: the links above work without JavaScript. This picks the right asset from the
  // latest GitHub release for the visitor's system and lists everything else.
  import { REPO } from '../data/site';

  interface Asset {
    name: string;
    browser_download_url: string;
    size: number;
  }

  type Arch = 'x64' | 'arm64' | 'x86' | 'arm';

  async function detectArch(): Promise<Arch> {
    const nav = navigator as Navigator & {
      userAgentData?: { getHighEntropyValues(hints: string[]): Promise<{ architecture?: string; bitness?: string }> };
    };
    try {
      const hints = await nav.userAgentData?.getHighEntropyValues(['architecture', 'bitness']);
      if (hints?.architecture === 'arm') return hints.bitness === '32' ? 'arm' : 'arm64';
      if (hints?.architecture === 'x86') return hints.bitness === '32' ? 'x86' : 'x64';
    } catch {
      // fall through to the user agent string
    }
    const ua = navigator.userAgent.toLowerCase();
    if (/aarch64|arm64/.test(ua)) return 'arm64';
    if (/armv7|armhf|\barm\b/.test(ua)) return 'arm';
    if (/wow64|win64|x86_64|x64|amd64/.test(ua)) return 'x64';
    return /i[3-6]86|win32/.test(ua) ? 'x86' : 'x64';
  }

  function detectOs(): 'windows' | 'linux' | 'other' {
    const ua = navigator.userAgent.toLowerCase();
    if (ua.includes('windows')) return 'windows';
    if (ua.includes('linux') && !ua.includes('android')) return 'linux';
    return 'other';
  }

  function size(bytes: number): string {
    return `${(bytes / 1_000_000).toFixed(0)} MB`;
  }

  function pick(assets: Asset[], os: string, arch: Arch): Asset | undefined {
    const find = (re: RegExp) => assets.find((a) => re.test(a.name));
    if (os === 'windows') return find(new RegExp(`^BrightSync-Setup-v[\\d.]+-win-${arch}\\.exe$`));
    if (os === 'linux') {
      return find(new RegExp(`^BrightSync-[\\d.]+-linux-${arch}\\.AppImage$`)) ?? find(/linux-portable\.tar\.gz$/);
    }
    return undefined;
  }

  /** Short, readable link text: "Installer win-x64", "Portable win-x64 (zip)", "linux-x64.deb". */
  function label(name: string): string {
    const core = name.replace(/^BrightSync-(Setup-)?v?[\d.]+-?/, '').replace(/\.(exe|zip)$/, '');
    if (name.includes('-Setup-')) return `Installer ${core}`;
    if (name.endsWith('.zip')) return `Portable ${core}`;
    return core;
  }

  function group(title: string, assets: Asset[]): HTMLElement {
    const card = document.createElement('div');
    card.className = 'card';
    const heading = document.createElement('h3');
    heading.textContent = title;
    const list = document.createElement('ul');
    for (const asset of assets) {
      const item = document.createElement('li');
      const link = document.createElement('a');
      link.href = asset.browser_download_url;
      link.rel = 'noopener';
      link.textContent = label(asset.name);
      const meta = document.createElement('span');
      meta.textContent = size(asset.size);
      item.append(link, meta);
      list.append(item);
    }
    card.append(heading, list);
    return card;
  }

  async function run() {
    const primary = document.querySelectorAll<HTMLAnchorElement>('[data-download-primary]');
    const labels = document.querySelectorAll<HTMLElement>('[data-download-label]');
    const status = document.querySelector<HTMLElement>('[data-download-status]');
    const note = document.querySelector<HTMLElement>('[data-download-note]');
    const list = document.querySelector<HTMLElement>('[data-download-list]');

    try {
      const response = await fetch(`https://api.github.com/repos/${REPO}/releases/latest`, {
        headers: { Accept: 'application/vnd.github+json' },
      });
      if (!response.ok) throw new Error(String(response.status));
      const release: { tag_name: string; assets: Asset[] } = await response.json();
      const assets = release.assets.filter((a) => !a.name.endsWith('.txt'));
      const os = detectOs();
      const arch = await detectArch();
      const best = pick(assets, os, arch);
      const version = release.tag_name.replace(/^v/, '');

      if (best) {
        const label = os === 'windows' ? `Download for Windows (${arch})` : `Download for Linux (${arch})`;
        primary.forEach((a) => (a.href = best.browser_download_url));
        labels.forEach((l) => (l.textContent = label));
        if (note) {
          note.hidden = false;
          note.textContent = `Version ${version}, ${size(best.size)}.`;
        }
      }
      if (status) {
        status.textContent = best
          ? `Latest version ${version}. We picked the build that matches your system; all builds are below.`
          : `Latest version ${version}. Choose your platform below.`;
      }

      if (list) {
        const windows = assets.filter((a) => /-win-/.test(a.name));
        const glibc = assets.filter((a) => /-linux-(x64|arm64|arm)\./.test(a.name));
        const musl = assets.filter((a) => /-linux-musl-/.test(a.name));
        const portable = assets.filter((a) => /linux-portable/.test(a.name));
        list.replaceChildren(
          ...[
            group('Windows', windows),
            group('Linux (glibc)', glibc),
            group('Linux (Alpine, musl)', musl),
            group('Any architecture', portable),
          ].filter((card) => card.querySelector('li')),
        );
        list.hidden = false;
      }
    } catch {
      if (status) {
        status.textContent = 'Could not reach GitHub from this page. Use the releases link to download.';
      }
    }
  }

  void run();
</script>
